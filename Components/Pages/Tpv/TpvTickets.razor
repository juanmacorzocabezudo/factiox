@page "/tpv/tickets"
@using FactioX.Models
@using FactioX.Services
@inherits TpvPaginaBase
@rendermode InteractiveServer

<PageTitle>Tickets TPV - FactioX</PageTitle>

<div class="container-fluid">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h2 class="mb-0"><i class="bi bi-receipt"></i> Tickets TPV</h2>
        <a href="tpv" class="btn btn-success ms-auto"><i class="bi bi-cart-fill"></i> Ir a venta</a>
    </div>

    @if (!Cargado)
    {
        <div class="spinner-border text-success"></div>
    }
    else if (ErrorCarga != null)
    {
        <div class="alert alert-danger">@ErrorCarga</div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body row g-2">
                <div class="col-md-2"><input type="date" class="form-control" @bind="filtro.Desde" /></div>
                <div class="col-md-2"><input type="date" class="form-control" @bind="filtro.Hasta" /></div>
                <div class="col-md-2">
                    <select class="form-select" @bind="filtroTerminal">
                        <option value="0">Todos los terminales</option>
                        @foreach (var t in terminales)
                        {
                            <option value="@t.Id">@t.Codigo</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" @bind="filtroEstado">
                        <option value="">Todos los estados</option>
                        @foreach (var e in Enum.GetValues<EstadoTicketTpv>())
                        {
                            <option value="@e">@e</option>
                        }
                    </select>
                </div>
                <div class="col-md-3"><input class="form-control" placeholder="Número, cliente o NIF" @bind="filtro.Texto" /></div>
                <div class="col-md-1 d-grid"><button class="btn btn-primary" @onclick="Buscar"><i class="bi bi-search"></i></button></div>
            </div>
        </div>

        @if (seleccionados.Any())
        {
            <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">
                <span>@seleccionados.Count tickets seleccionados (@tickets.Where(t => seleccionados.Contains(t.Id)).Sum(t => t.Total).ToString("C2"))</span>
                <select class="form-select w-auto" @bind="clienteFacturaId">
                    <option value="0">Cliente para la factura...</option>
                    @foreach (var c in clientes.Where(c => !string.IsNullOrWhiteSpace(c.NIF)))
                    {
                        <option value="@c.Id">@NombreCliente(c) (@c.NIF)</option>
                    }
                </select>
                <button class="btn btn-primary" disabled="@(clienteFacturaId == 0)" @onclick="FacturarSeleccionados"><i class="bi bi-receipt"></i> Facturar juntos</button>
                <button class="btn btn-link" @onclick="() => seleccionados.Clear()">Quitar selección</button>
            </div>
        }

        <div class="card">
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Número</th>
                            <th>Fecha</th>
                            <th>Terminal</th>
                            <th>Usuario</th>
                            <th>Cliente</th>
                            <th class="text-end">Total</th>
                            <th>Estado</th>
                            <th>Factura</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in tickets)
                        {
                            var facturable = !t.EsDevolucion && t.Estado == EstadoTicketTpv.Cobrado;
                            <tr @ondblclick="() => VerDetalle(t.Id)" style="cursor: pointer;">
                                <td>
                                    @if (facturable)
                                    {
                                        <input type="checkbox" class="form-check-input" checked="@seleccionados.Contains(t.Id)" @onchange="() => AlternarSeleccion(t.Id)" />
                                    }
                                </td>
                                <td>
                                    <strong>@(t.Numero ?? "—")</strong>
                                    @if (t.EsDevolucion)
                                    {
                                        <span class="badge bg-danger ms-1">Devolución</span>
                                    }
                                </td>
                                <td>@((t.FechaCobro ?? t.Fecha).ToString("dd/MM/yyyy HH:mm"))</td>
                                <td>@t.Terminal?.Codigo</td>
                                <td>@t.Usuario?.NombreCompleto</td>
                                <td>@NombreCliente(t.Cliente)</td>
                                <td class="text-end fw-bold @(t.Total < 0 ? "text-danger" : "")">@t.Total.ToString("C2")</td>
                                <td><span class="badge @ClaseEstado(t.Estado)">@t.Estado</span></td>
                                <td>
                                    @if (t.Factura != null)
                                    {
                                        <a href="@(t.EsDevolucion ? "abonos-venta" : "facturas-venta")">@t.Factura.NumeroFactura</a>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-secondary" title="Ver" @onclick="() => VerDetalle(t.Id)"><i class="bi bi-eye"></i></button>
                                    @if (t.Numero != null)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" title="Reimprimir" @onclick="() => Reimprimir(t.Id)"><i class="bi bi-printer"></i></button>
                                    }
                                    @if (!t.EsDevolucion && t.Estado is EstadoTicketTpv.Cobrado or EstadoTicketTpv.Facturado)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" title="Devolver" @onclick="() => AbrirDevolucion(t.Id)"><i class="bi bi-arrow-return-left"></i></button>
                                    }
                                    @if (t.Editable)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" title="Anular" @onclick="() => Anular(t.Id)"><i class="bi bi-x-circle"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!tickets.Any())
                {
                    <p class="text-muted p-3 mb-0">No hay tickets con estos filtros.</p>
                }
            </div>
        </div>
    }
</div>

@if (detalle != null)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(modoDevolucion ? "Devolución del ticket" : "Ticket") @(detalle.Numero ?? "(sin número)")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarDetalle"></button>
                </div>
                <div class="modal-body">
                    <div class="row small mb-2">
                        <div class="col-md-6">
                            <div>Fecha: @((detalle.FechaCobro ?? detalle.Fecha).ToString("dd/MM/yyyy HH:mm"))</div>
                            <div>Terminal: @detalle.Terminal?.Codigo · @detalle.Usuario?.NombreCompleto</div>
                            <div>Cliente: @NombreCliente(detalle.Cliente)</div>
                        </div>
                        <div class="col-md-6">
                            @if (detalle.TicketOriginal != null)
                            {
                                <div>Rectifica a: <strong>@detalle.TicketOriginal.Numero</strong></div>
                            }
                            @if (detalle.PresupuestoOrigen != null)
                            {
                                <div>Presupuesto: <strong>@detalle.PresupuestoOrigen.Numero</strong></div>
                            }
                            @if (detalle.Factura != null)
                            {
                                <div>@(detalle.EsDevolucion ? "Abono" : "Factura"): <strong>@detalle.Factura.NumeroFactura</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(detalle.Notas))
                            {
                                <div>Notas: @detalle.Notas</div>
                            }
                        </div>
                    </div>

                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Descripción</th>
                                <th class="text-end">Cant.</th>
                                <th class="text-end">PVP</th>
                                <th class="text-end">Dto.</th>
                                <th class="text-end">Importe</th>
                                @if (modoDevolucion)
                                {
                                    <th class="text-end">Devuelto</th>
                                    <th style="width: 110px;">A devolver</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in detalle.Lineas)
                            {
                                <tr>
                                    <td>@l.Descripcion</td>
                                    <td class="text-end">@l.Cantidad.ToString("0.##")</td>
                                    <td class="text-end">@Pvp(l).ToString("C2")</td>
                                    <td class="text-end">@(l.Descuento > 0 ? $"{l.Descuento:0.##}%" : "")</td>
                                    <td class="text-end">@ImporteLinea(l).ToString("C2")</td>
                                    @if (modoDevolucion)
                                    {
                                        <td class="text-end">@devueltas.GetValueOrDefault(ITpvService.ClaveLinea(l)).ToString("0.##")</td>
                                        <td>
                                            <input type="number" step="1" min="0" max="@Disponible(l)" class="form-control form-control-sm"
                                                   value="@cantidadesDevolucion.GetValueOrDefault(l.Id)" @onchange="e => CambiarCantidadDevolucion(l, e)" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (!modoDevolucion)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                @foreach (var d in detalle.DesgloseIVA())
                                {
                                    <div class="small">IVA @d.Tipo.ToString("0.##")%: base @d.Base.ToString("C2") · cuota @d.Cuota.ToString("C2")</div>
                                }
                                @if (detalle.DescuentoGlobal != 0)
                                {
                                    <div class="small">Descuento global: @detalle.DescuentoGlobal.ToString("0.##")%</div>
                                }
                            </div>
                            <div class="col-md-6 text-end">
                                @foreach (var p in detalle.Pagos)
                                {
                                    <div class="small">@(p.FormaPagoPersonalizada?.Nombre ?? "Pago"): @p.Importe.ToString("C2")</div>
                                }
                                <div class="fs-4 fw-bold">@detalle.Total.ToString("C2")</div>
                            </div>
                        </div>

                        @if (!detalle.EsDevolucion && detalle.Estado == EstadoTicketTpv.Cobrado)
                        {
                            <div class="border-top pt-2 mt-2">
                                <label class="form-label small">Canjear por factura completa</label>
                                <div class="input-group">
                                    <select class="form-select" @bind="clienteFacturaId">
                                        <option value="0">Seleccione cliente con NIF...</option>
                                        @foreach (var c in clientes.Where(c => !string.IsNullOrWhiteSpace(c.NIF)))
                                        {
                                            <option value="@c.Id">@NombreCliente(c) (@c.NIF)</option>
                                        }
                                    </select>
                                    <button class="btn btn-primary" disabled="@(clienteFacturaId == 0)" @onclick="FacturarDetalle">Convertir a factura</button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small">Terminal (caja abierta)</label>
                                <select class="form-select" @bind="terminalDevolucionId">
                                    @foreach (var t in terminales.Where(t => t.Activo))
                                    {
                                        <option value="@t.Id">@t.Codigo - @t.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Reembolso</label>
                                <select class="form-select" @bind="formaReembolsoId">
                                    @foreach (var f in formasPago)
                                    {
                                        <option value="@f.Id">@f.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Motivo</label>
                                <input class="form-control" maxlength="500" @bind="motivoDevolucion" />
                            </div>
                        </div>
                        @if (detalle.Estado == EstadoTicketTpv.Facturado)
                        {
                            <div class="alert alert-info small mt-2 mb-0">El ticket está facturado: se generará automáticamente un abono de venta vinculado a la factura @detalle.Factura?.NumeroFactura.</div>
                        }
                        <div class="text-end fs-5 mt-2">A devolver: <strong class="text-danger">@ImporteDevolucion.ToString("C2")</strong></div>
                    }
                </div>
                <div class="modal-footer">
                    @if (modoDevolucion)
                    {
                        <button class="btn btn-secondary" @onclick="CerrarDetalle">Cancelar</button>
                        <button class="btn btn-danger" disabled="@(!cantidadesDevolucion.Values.Any(v => v > 0) || procesando)" @onclick="ConfirmarDevolucion">
                            <i class="bi bi-arrow-return-left"></i> Confirmar devolución
                        </button>
                    }
                    else
                    {
                        @if (detalle.Numero != null)
                        {
                            <button class="btn btn-outline-secondary" @onclick="() => Reimprimir(detalle.Id)"><i class="bi bi-printer"></i> Reimprimir</button>
                        }
                        <button class="btn btn-secondary" @onclick="CerrarDetalle">Cerrar</button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private FiltroTicketsTpv filtro = new() { Desde = DateTime.Today.AddDays(-7), Hasta = DateTime.Today };
    private int filtroTerminal;
    private string filtroEstado = "";
    private List<TicketTpv> tickets = new();
    private List<TpvTerminal> terminales = new();
    private List<Cliente> clientes = new();
    private List<FormaPagoPersonalizada> formasPago = new();
    private HashSet<int> seleccionados = new();
    private int clienteFacturaId;
    private bool procesando;

    private TicketTpv? detalle;
    private bool modoDevolucion;
    private Dictionary<string, decimal> devueltas = new();
    private Dictionary<int, decimal> cantidadesDevolucion = new();
    private int terminalDevolucionId;
    private int formaReembolsoId;
    private string motivoDevolucion = "";

    private decimal ImporteDevolucion
    {
        get
        {
            if (detalle == null) return 0;
            var simulado = new TicketTpv
            {
                DescuentoGlobal = detalle.DescuentoGlobal,
                Lineas = detalle.Lineas.Where(l => cantidadesDevolucion.GetValueOrDefault(l.Id) > 0)
                    .Select(l => new LineaDocumento { Cantidad = cantidadesDevolucion[l.Id], PrecioUnitario = l.PrecioUnitario, IVA = l.IVA, Descuento = l.Descuento })
                    .ToList()
            };
            simulado.CalcularTotales();
            return simulado.Total;
        }
    }

    protected override async Task CargarAsync()
    {
        terminales = await TpvService.ObtenerTerminalesAsync(soloActivos: false);
        clientes = await TpvService.ObtenerClientesAsync();
        formasPago = await TpvService.ObtenerFormasPagoAsync();
        await Buscar();
    }

    private async Task Buscar()
    {
        filtro.TerminalId = filtroTerminal == 0 ? null : filtroTerminal;
        filtro.Estado = Enum.TryParse<EstadoTicketTpv>(filtroEstado, out var estado) ? estado : null;
        tickets = await TpvService.BuscarTicketsAsync(filtro);
        seleccionados.RemoveWhere(id => !tickets.Any(t => t.Id == id && t.Estado == EstadoTicketTpv.Cobrado));
    }

    private void AlternarSeleccion(int id)
    {
        if (!seleccionados.Remove(id)) seleccionados.Add(id);
    }

    private async Task VerDetalle(int id)
    {
        detalle = await TpvService.ObtenerTicketAsync(id);
        modoDevolucion = false;
        clienteFacturaId = detalle?.ClienteId is { } c && clientes.Any(x => x.Id == c && !string.IsNullOrWhiteSpace(x.NIF))
            && !terminales.Any(t => t.ClienteGenericoId == c) ? c : 0;
    }

    private async Task AbrirDevolucion(int id)
    {
        detalle = await TpvService.ObtenerTicketAsync(id);
        if (detalle == null) return;
        modoDevolucion = true;
        devueltas = await TpvService.ObtenerCantidadesDevueltasAsync(id);
        cantidadesDevolucion = new();
        motivoDevolucion = "";
        var guardado = await LeerTerminalGuardadoAsync();
        terminalDevolucionId = terminales.Any(t => t.Id == guardado && t.Activo) ? guardado!.Value : terminales.FirstOrDefault(t => t.Activo)?.Id ?? 0;
        formaReembolsoId = detalle.Pagos.FirstOrDefault()?.FormaPagoPersonalizadaId ?? formasPago.FirstOrDefault()?.Id ?? 0;
    }

    private decimal Disponible(LineaDocumento linea)
    {
        var clave = ITpvService.ClaveLinea(linea);
        var vendido = detalle!.Lineas.Where(l => ITpvService.ClaveLinea(l) == clave).Sum(l => l.Cantidad);
        var reservado = detalle.Lineas.Where(l => l.Id != linea.Id && ITpvService.ClaveLinea(l) == clave).Sum(l => cantidadesDevolucion.GetValueOrDefault(l.Id));
        return Math.Max(0, vendido - devueltas.GetValueOrDefault(clave) - reservado);
    }

    private void CambiarCantidadDevolucion(LineaDocumento linea, ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString()?.Replace(',', '.'), System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var cantidad))
            cantidad = 0;
        cantidadesDevolucion[linea.Id] = Math.Clamp(cantidad, 0, Disponible(linea));
    }

    private async Task ConfirmarDevolucion()
    {
        if (detalle == null || procesando) return;
        procesando = true;
        TicketTpv? devolucion = null;
        var lineas = cantidadesDevolucion.Where(c => c.Value > 0)
            .Select(c => new LineaDevolucionTpv { LineaId = c.Key, Cantidad = c.Value }).ToList();
        var ok = await EjecutarAsync(async () =>
            devolucion = await TpvService.DevolverAsync(detalle.Id, lineas, terminalDevolucionId, formaReembolsoId, motivoDevolucion));
        procesando = false;
        if (!ok) return;

        CerrarDetalle();
        await Buscar();
        if (await JS.InvokeAsync<bool>("confirm", $"Devolución {devolucion!.Numero} registrada por {devolucion.Total:C2}. ¿Imprimir justificante?"))
            await Reimprimir(devolucion.Id);
    }

    private async Task FacturarDetalle()
    {
        if (detalle == null || clienteFacturaId == 0) return;
        Factura? factura = null;
        if (await EjecutarAsync(async () => factura = await TpvService.ConvertirTicketEnFacturaAsync(detalle.Id, clienteFacturaId)))
        {
            await JS.InvokeVoidAsync("alert", $"Factura {factura!.NumeroFactura} emitida.");
            CerrarDetalle();
            await Buscar();
        }
    }

    private async Task FacturarSeleccionados()
    {
        if (!seleccionados.Any() || clienteFacturaId == 0) return;
        Factura? factura = null;
        if (await EjecutarAsync(async () => factura = await TpvService.FacturarTicketsAsync(clienteFacturaId, seleccionados.ToList())))
        {
            await JS.InvokeVoidAsync("alert", $"Factura {factura!.NumeroFactura} emitida con {seleccionados.Count} tickets.");
            seleccionados.Clear();
            clienteFacturaId = 0;
            await Buscar();
        }
    }

    private async Task Anular(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "¿Anular este ticket no cobrado?")) return;
        if (await EjecutarAsync(() => TpvService.AnularAsync(id)))
            await Buscar();
    }

    private Task Reimprimir(int id) => EjecutarAsync(() => ImprimirTicketAsync(id, 80));

    private void CerrarDetalle()
    {
        detalle = null;
        modoDevolucion = false;
        clienteFacturaId = 0;
    }
}
